generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Role {
  ADMIN
  TECNICO
  ALMACENERO
}

enum SolicitudEstado {
  PENDIENTE
  EJECUTADA
  REPROGRAMADA
  RECHAZADA
}

enum EquipoEstado {
  DISPONIBLE
  ASIGNADO
  INSTALADO
  DANADO
  RECUPERADO
}

// --- MODELOS ---

model Usuario {
  id       String  @id @default(uuid())
  nombre   String
  username String  @unique
  password String
  rol      Role    @default(TECNICO)
  activo   Boolean @default(false)

  // Relaciones
  instalaciones  Instalacion[]
  recuperaciones EquipoRecuperado[]
  stockPersonal  StockTecnico[]
  herramientas   Herramienta[]
  asignaciones   Asignacion[]
  equiposEnPoder Equipo[]
  movimientos    MovimientoInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id            String @id @default(uuid())
  nombre        String @unique
  unidad        String // "Metros" o "Unidades"
  cantidadTotal Int    @default(0)

  stocksTecnicos StockTecnico[]
  movimientos    MovimientoInventario[]
  instalaciones  MaterialUsado[]
}

model StockTecnico {
  id         String @id @default(uuid())
  tecnicoId  String
  materialId String
  asignado   Int    @default(0)
  utilizado  Int    @default(0)

  tecnico  Usuario  @relation(fields: [tecnicoId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([tecnicoId, materialId])
}

model Equipo {
  id        String       @id @default(uuid())
  tipo      String // "ROUTER" o "IPTV"
  sn        String?      @unique
  mac       String?      @unique
  estado    EquipoEstado @default(DISPONIBLE)
  updatedAt DateTime     @default(now()) @updatedAt

  // Valores por defecto para permitir registrar equipos antiguos
  marca  String? @default("GENERICA")
  modelo String? @default("RECUPERADO")

  fuente        Boolean @default(true)
  hdmi          Boolean @default(false)
  patchcord_sc  Boolean @default(false)
  patchcord_utp Boolean @default(false)

  poseedorId String?
  poseedor   Usuario? @relation(fields: [poseedorId], references: [id])

  createdAt DateTime @default(now())
}

model Instalacion {
  id               String          @id @default(uuid())
  numSolicitud     String          @unique
  cliente          String          @default("CLIENTE NUEVO")
  tipo             String
  estado           SolicitudEstado @default(EJECUTADA)
  observacion      String?         @db.Text
  latitud          Float?
  longitud         Float?
  fotos            String[]
  firmaDigital     String?         @db.Text
  router_sn        String?
  iptv_macs        String[]
  tecnicoId        String
  tecnico          Usuario         @relation(fields: [tecnicoId], references: [id])
  fecha            DateTime        @default(now())
  materialesUsados MaterialUsado[]
}

model MaterialUsado {
  id       String @id @default(uuid())
  cantidad Int

  instalacionId String
  instalacion   Instalacion @relation(fields: [instalacionId], references: [id])

  materialId String
  material   Material @relation(fields: [materialId], references: [id])
}

model EquipoRecuperado {
  id             String   @id @default(uuid())
  numSolicitud   String
  clienteNombre  String
  tecnicoCelular String?
  fechaRetiro    DateTime @default(now())

  // Identificación de Hardware (Soporta lo que envía el formulario)
  sn_mac        String // Aquí se guarda el SN del Router
  mac_deco      String? // Para la MAC del IPTV (opcional)
  tipo_servicio String  @default("ROUTER") // "ROUTER" o "IPTV"

  estadoEquipo  String // "BUENO", "MALO"
  accesorios    String  @default("Completo")
  observaciones String? @db.Text
  firmaDigital  String? @db.Text

  tecnicoId String
  tecnico   Usuario @relation(fields: [tecnicoId], references: [id])
}

model Herramienta {
  id     String @id @default(uuid())
  nombre String
  estado String @default("DISPONIBLE")

  poseedorId String?
  poseedor   Usuario? @relation(fields: [poseedorId], references: [id])
}

model Asignacion {
  id           String   @id @default(uuid())
  numSolicitud String
  tecnicoId    String
  tecnico      Usuario  @relation(fields: [tecnicoId], references: [id])
  completada   Boolean  @default(false)
  fecha        DateTime @default(now())
}

model MovimientoInventario {
  id         String  @id @default(uuid())
  materialId String
  usuarioId  String
  cantidad   Int
  tipo       String // "ENTRADA" o "SALIDA"
  motivo     String?

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())
}
